# Copy to .env and fill in. Never commit .env.

# Public URL people use to reach the app (behind your reverse proxy).
APP_URL=https://finance.example.com

# Long random string: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Pocket ID
OIDC_ISSUER=https://id.example.com
OIDC_CLIENT_ID=
# Leave empty if you made the Pocket ID client a "public client" (PKCE only).
OIDC_CLIENT_SECRET=

# Optional: limit who can sign in (comma-separated). Pocket ID can also
# restrict the client to user groups itself.
OIDC_ALLOWED_GROUPS=
OIDC_ALLOWED_EMAILS=

# Local development only: skip login entirely. Never set this on a server.
AUTH_DISABLED=false
